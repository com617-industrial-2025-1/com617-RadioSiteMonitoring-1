; Solent_Test A  —  MODE A: Home / no hardware
general {
    dabmode 1
    nbframes 0
    syslog true
    tist true
    managementport 12720
}

remotecontrol {
    telnetport 12721
}

; ─── Ensemble ───────────────────────────────────────────────────────────────

ensemble {
    id      0xc1d6
    ecc     0xe1
    local-time-offset auto
    reconfig-counter hash
    label      "Solent Uni"
    shortlabel "Slnt Uni"
}

; ─── Services ───────────────────────────────────────────────────────────────

services {
    srv-01 {
        id  0xc3ee
        ecc 0xe1
        label      "Radio Caroline"
        shortlabel "Caroline"
        pty 10
        pty-sd static
        language 0x09
    }
    srv-02 {
        id  0xc1c5
        ecc 0xe1
        label      "Flash On Air"
        shortlabel "Flash"
        pty 10
        pty-sd static
        language 0x09
    }
    srv-03 {
        id  0xc144
        ecc 0xe1
        label      "XRadio"
        shortlabel "XRadio"
        pty 13
        pty-sd static
        language 0x09
    }
}

; ─── Subchannels ────────────────────────────────────────────────────────────

subchannels {
    sub-01 {
        type dabplus
        bitrate 64
        id 1
        protection 3
        inputproto edi
        inputuri "tcp://:10001"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
    }
    sub-02 {
        type dabplus
        bitrate 64
        id 2
        protection 3
        inputproto edi
        inputuri "tcp://:10002"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
    }
    sub-03 {
        type dabplus
        bitrate 64
        id 3
        protection 3
        inputproto edi
        inputuri "tcp://:10003"
        buffer-management prebuffering
        buffer 80
        prebuffering 40
    }
}

; ─── Components ─────────────────────────────────────────────────────────────

components {
    comp-01 {
        service srv-01
        subchannel sub-01
        user-applications {
            userapp "slideshow"
        }
    }
    comp-02 {
        service srv-02
        subchannel sub-02
        user-applications {
            userapp "slideshow"
        }
    }
    comp-03 {
        service srv-03
        subchannel sub-03
        user-applications {
            userapp "slideshow"
        }
    }
}

; ─── Outputs ────────────────────────────────────────────────────────────────

outputs {
    edi {
        destinations {
            edi_tcp {
                protocol tcp
                listenport 13000
                enable_pft true
                fec 1
            }
        }
    }
    throttle "simul://"
}