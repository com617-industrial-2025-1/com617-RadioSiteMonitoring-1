; ODR-DabMux configuration — Solent Uni ensemble
; Written by myself (Sebastian) as part of the DAB radio monitoring project.
; This config is identical for both Mode A and Mode B — the mux does not
; care whether the modulator is using hardware or not.

general {
    ; DAB transmission mode 1 — standard for UK terrestrial DAB.
    dabmode 1
    ; Run indefinitely (0 = no frame limit).
    nbframes 0
    ; Send log output to syslog for persistent fault analysis.
    syslog true
    ; Enable timestamps in ETI frames — required for the modulator to
    ; align transmission frames correctly.
    tist true
    ; Enable the ZMQ management stats server on port 12720.
    ; Queried by extract_stats.py to get buffer levels and stream state.
    managementport 12720
}

remotecontrol {
    ; Enable the telnet remote control interface on port 12721.
    ; Used to inspect and change mux parameters at runtime.
    telnetport 12721
}

; Ensemble definition — the top-level DAB multiplex container.
ensemble {
    ; Ensemble ID and Extended Country Code for the UK.
    id 0xc1d6
    ecc 0xe1
    local-time-offset auto
    reconfig-counter hash
    label "Solent Uni"
    shortlabel "Slnt Uni"
}

; Three services broadcast in this ensemble.
services {
    srv-01 {
        id 0xc3ee
        ecc 0xe1
        label "Test Service 1"
        shortlabel "Test 1"
        ; Programme type 10 = Pop Music.
        pty 10
        pty-sd static
        ; Language code 0x09 = English.
        language 0x09
    }
    srv-02 {
        id 0xc1c5
        ecc 0xe1
        label "Test Service 2"
        shortlabel "Test 2"
        pty 10
        pty-sd static
        language 0x09
    }
    srv-03 {
        id 0xc144
        ecc 0xe1
        label "Test Service 3"
        shortlabel "Test 3"
        ; Programme type 13 = News.
        pty 13
        pty-sd static
        language 0x09
    }
}

; Subchannels receive encoded audio from the three encoder instances
; via EDI/TCP. Each encoder pushes to a different port.
subchannels {
    sub-01 {
        type dabplus
        ; 64 kbps — standard quality for DAB+ speech and music.
        bitrate 64
        id 1
        ; EEP protection level 3-A.
        protection 3
        inputproto edi
        ; Encoder 1 connects to this port inside the Docker network.
        inputuri "tcp://:10001"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
    }
    sub-02 {
        type dabplus
        bitrate 64
        id 2
        protection 3
        inputproto edi
        inputuri "tcp://:10002"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
    }
    sub-03 {
        type dabplus
        bitrate 64
        id 3
        protection 3
        inputproto edi
        inputuri "tcp://:10003"
        buffer-management prebuffering
        ; Larger buffer for sub-03 to handle the mono xrad.io stream.
        buffer 80
        prebuffering 40
    }
}

; Components link each service to its subchannel.
components {
    comp-01 {
        service srv-01
        subchannel sub-01
        user-applications {
            userapp "slideshow"
        }
    }
    comp-02 {
        service srv-02
        subchannel sub-02
        user-applications {
            userapp "slideshow"
        }
    }
    comp-03 {
        service srv-03
        subchannel sub-03
        user-applications {
            userapp "slideshow"
        }
    }
}

outputs {
    edi {
        destinations {
            ; EDI output over TCP — the modulator container connects to this port.
            ; TCP is used instead of UDP to avoid a multicast address error
            ; in the version of ODR-DabMod used in this project.
            edi_tcp {
                protocol tcp
                listenport 13000
            }
        }
    }

    ; Throttle the mux to real-time — one ETI frame every 24ms.
    throttle "simul://"
}
